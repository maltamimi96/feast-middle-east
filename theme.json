{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "820px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "forest", "name": "Forest", "color": "#173f32" },
        { "slug": "cedar", "name": "Cedar", "color": "#2f765c" },
        { "slug": "red", "name": "Red", "color": "#b83d35" },
        { "slug": "cream", "name": "Cream", "color": "#f7f1e6" },
        { "slug": "paper", "name": "Paper", "color": "#fffdf8" },
        { "slug": "sand", "name": "Sand", "color": "#dfc89f" },
        { "slug": "ink", "name": "Ink", "color": "#171b18" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.5rem" },
        { "slug": "30", "name": "XS", "size": "0.75rem" },
        { "slug": "40", "name": "S", "size": "1rem" },
        { "slug": "50", "name": "M", "size": "1.5rem" },
        { "slug": "60", "name": "L", "size": "2.5rem" },
        { "slug": "70", "name": "XL", "size": "4rem" },
        { "slug": "80", "name": "2XL", "size": "7rem" },
        { "slug": "90", "name": "Header offset", "size": "11rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "poppins", "name": "Poppins", "fontFamily": "\"Poppins\", sans-serif" },
        { "slug": "script", "name": "Dancing Script", "fontFamily": "\"Dancing Script\", cursive" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.82rem" },
        { "slug": "medium", "name": "Body", "size": "1rem" },
        { "slug": "large", "name": "Lead", "size": "1.25rem" },
        { "slug": "x-large", "name": "Large heading", "size": "clamp(2.5rem,5vw,4.8rem)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(3rem,6.4vw,5.75rem)" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": true
  },
  "styles": {
    "color": { "background": "#fffdf8", "text": "#171b18" },
    "spacing": { "blockGap": "1.25rem" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--poppins)", "fontSize": "1rem", "lineHeight": "1.65" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--poppins)", "fontWeight": "600", "lineHeight": "1.05", "letterSpacing": "-0.045em" } },
      "button": { "color": { "background": "#173f32", "text": "#ffffff" }, "border": { "radius": "2px" }, "typography": { "fontSize": "0.82rem", "fontWeight": "600", "letterSpacing": "0.05em", "textTransform": "uppercase" } },
      "link": { "color": { "text": "#173f32" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
